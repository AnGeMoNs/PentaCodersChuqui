      propertyPath: documentBody
      value: "HOSPITAL ROY H. GLOVER \u2014 CHUQUICAMATA\nA\xF1o de ingreso: 1985\nPaciente:
        Sebasti\xE1n M. (Pabell\xF3n Pedi\xE1trico)\n\nObservaciones: Tras el incidente
