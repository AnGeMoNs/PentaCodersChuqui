    - target: {fileID: 2753216795886208988, guid: 2875756b87fb3a342b1a6f0bfb01386c, type: 3}
      propertyPath: m_Name
      value: Nota_Recepcion
      objectReference: {fileID: 0}
    - target: {fileID: 6558225926759667522, guid: 2875756b87fb3a342b1a6f0bfb01386c, type: 3}
      propertyPath: documentBody
      value: "\"La fecha de aquel incidente sigue escrita en estas paredes, aunque
        nadie pueda verla.\"\n\nLevanta la c\xE1mara de video (Clic derecho) y activa
        la visi\xF3n nocturna (Tecla F) para inspeccionar la pared deteriorada de
        la Sala de Enfermer\xEDa.\n\nEse a\xF1o de 4 d\xEDgitos abre el teclado num\xE9rico
        de la puerta de Administraci\xF3n."
      objectReference: {fileID: 0}
    - target: {fileID: 6558225926759667522, guid: 2875756b87fb3a342b1a6f0bfb01386c, type: 3}
      propertyPath: documentTitle
      value: "Nota en Recepci\xF3n \u2014 Hospital Roy H. Glover"
      objectReference: {fileID: 0}
    - target: {fileID: 6558225926759667522, guid: 2875756b87fb3a342b1a6f0bfb01386c, type: 3}
      propertyPath: interactionText
      value: "Leer nota de recepci\xF3n"
      objectReference: {fileID: 0}
